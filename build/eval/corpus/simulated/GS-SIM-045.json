  "messages": [
    {
      "role": "Client",
      "text": "Letzte Woche ist etwas passiert, darueber moechte ich heute sprechen.",
      "start_time": 0.0
    },
    {
      "role": "Therapist",
      "text": "Ich hoere Ihnen zu. Erzaehlen Sie mir, was vorgefallen ist.",
      "start_time": 3.1
    },
    {
      "role": "Client",
      "text": "Es geht um einen Streit mit meinem Partner. Das hat mich sehr aufgewaehlt.",
      "start_time": 5.9
    },
    {
      "role": "Therapist",
      "text": "Lassen Sie uns das gemeinsam anschauen. Was genau ist passiert?",
      "start_time": 8.9
    },
    {
      "role": "Client",
      "text": "Ich sehe mich immer als den Starken, der alles alleine schafft.",
      "start_time": 11.9
    },
    {
      "role": "Therapist",
      "text": "Woher kommt dieses Bild von sich?",
      "start_time": 15.1
    },
    {
      "role": "Client",
      "text": "Ich musste immer funktionieren. Schwaeche war keine Option.",
      "start_time": 18.3
    },
    {
      "role": "Therapist",
      "text": "Was waere, wenn Staerke auch bedeuten koennte, sich Hilfe zu holen?",
      "start_time": 21.3
    },
    {
      "role": "Client",
      "text": "Meine Freunde sagen, ich sei kalt. Aber innen drin fuehle ich so viel.",
      "start_time": 24.3
    },
    {
      "role": "Therapist",
      "text": "Wie erleben Sie diesen Widerspruch?",
      "start_time": 27.3
    },
    {
      "role": "Client",
      "text": "Es macht mich traurig. Als waere ich unsichtbar.",
      "start_time": 30.5
    },
    {
      "role": "Therapist",
      "text": "Die Diskrepanz zwischen dem, was innen ist, und dem, was aussen ankommt, scheint schmerzhaft.",
      "start_time": 33.5
    },
    {
      "role": "Client",
      "text": "Wer bin ich eigentlich, wenn ich nicht die Rolle spiele, die alle erwarten?",
      "start_time": 36.7
    },
    {
      "role": "Therapist",
      "text": "Haben Sie eine Ahnung davon?",
      "start_time": 39.8
    },
    {
      "role": "Client",
      "text": "Nein. Und das macht mir Angst. Was wenn da nichts ist?",
      "start_time": 42.9
    },
    {
      "role": "Therapist",
      "text": "Die Tatsache, dass Sie diese Frage stellen, zeigt mir, dass da sehr wohl etwas ist.",
      "start_time": 45.8
    },
    {
      "role": "Client",
      "text": "Ich moechte mich trauen, so zu sein, wie ich wirklich bin.",
      "start_time": 49.0
    },
    {
      "role": "Therapist",
      "text": "Was waere ein erster Schritt dahin?",
      "start_time": 51.8
    },
    {
      "role": "Client",
      "text": "Vielleicht meiner Schwester zu sagen, dass ich auch mal Hilfe brauche.",
      "start_time": 54.8
    },
    {
      "role": "Therapist",
      "text": "Das waere ein mutiger und authentischer Schritt. Was hindert Sie noch?",
      "start_time": 57.7
    }
  ],
