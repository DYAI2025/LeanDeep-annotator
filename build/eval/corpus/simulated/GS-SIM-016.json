  "language": "de",
  "theme": "familie",
  "messages": [
    {
      "role": "Client",
      "text": "Ich weiss nicht, wo ich anfangen soll heute.",
      "start_time": 0.0
    },
    {
      "role": "Therapist",
      "text": "Nehmen Sie sich die Zeit, die Sie brauchen. Was beschaeftigt Sie gerade am meisten?",
      "start_time": 3.0
    },
    {
      "role": "Client",
      "text": "Es ist alles so viel gerade. Ich fuehle mich ueberwaeltigt.",
      "start_time": 5.9
    },
    {
      "role": "Therapist",
      "text": "Das hoert sich belastend an. Lassen Sie uns gemeinsam schauen, was gerade am draengendsten ist.",
      "start_time": 8.7
    },
    {
      "role": "Client",
      "text": "Bei uns zuhause wurde nie ueber Gefuehle gesprochen.",
      "start_time": 11.7
    },
    {
      "role": "Therapist",
      "text": "Wie war das fuer Sie als Kind?",
      "start_time": 14.9
    },
    {
      "role": "Client",
      "text": "Ich habe gelernt, dass man funktionieren muss. Weinen war nicht erlaubt.",
      "start_time": 17.8
    },
    {
      "role": "Therapist",
      "text": "Das klingt nach einem sehr engen Rahmen fuer ein Kind.",
      "start_time": 20.8
    },
    {
      "role": "Client",
      "text": "Ich halte Menschen immer auf Abstand. Naeher als bis hierhin kommt niemand.",
      "start_time": 23.7
    },
    {
      "role": "Therapist",
      "text": "Wann haben Sie angefangen, sich so zu schuetzen?",
      "start_time": 26.8
    },
    {
      "role": "Client",
      "text": "Schon als Kind. Meine Mutter war unberechenbar. Mal liebevoll, mal eiskalt.",
      "start_time": 29.8
    },
    {
      "role": "Therapist",
      "text": "Das macht Sinn, dass Sie dann gelernt haben, Naehe als gefaehrlich zu erleben.",
      "start_time": 32.7
    },
    {
      "role": "Client",
      "text": "Ich muss mich nicht mehr dafuer verantwortlich fuehlen, ob es meiner Mutter gut geht.",
      "start_time": 35.6
    },
    {
      "role": "Therapist",
      "text": "Was veraendert sich, wenn Sie diesen Gedanken zulassen?",
      "start_time": 38.7
    },
    {
      "role": "Client",
      "text": "Ich fuehle mich leichter. Aber auch schuldig.",
      "start_time": 41.9
    },
    {
      "role": "Therapist",
      "text": "Beides darf da sein. Abloesung bedeutet nicht Lieblosigkeit.",
      "start_time": 44.8
    },
    {
      "role": "Client",
      "text": "Ich kann nicht mein ganzes Leben damit verbringen, andere zu retten.",
      "start_time": 47.9
    },
    {
      "role": "Therapist",
      "text": "Was moechten Sie stattdessen fuer sich tun?",
      "start_time": 51.1
    },
    {
      "role": "Client",
      "text": "Meine eigenen Beduerfnisse ernst nehmen. Das faellt mir noch schwer.",
      "start_time": 54.0
    },
    {
      "role": "Therapist",
      "text": "Es ist ein Prozess. Aber Sie haben bereits angefangen, sich selbst wahrzunehmen.",
      "start_time": 57.0
    }
  ],
