  "messages": [
    {
      "role": "Client",
      "text": "Es geht um einen Streit mit meinem Partner. Das hat mich sehr aufgewaehlt.",
      "start_time": 0.0
    },
    {
      "role": "Therapist",
      "text": "Lassen Sie uns das gemeinsam anschauen. Was genau ist passiert?",
      "start_time": 2.8
    },
    {
      "role": "Client",
      "text": "Letzte Woche ist etwas passiert, darueber moechte ich heute sprechen.",
      "start_time": 6.1
    },
    {
      "role": "Therapist",
      "text": "Ich hoere Ihnen zu. Erzaehlen Sie mir, was vorgefallen ist.",
      "start_time": 9.2
    },
    {
      "role": "Client",
      "text": "Er sagte, ich waere nicht belastbar genug. Das hat mich rasend gemacht.",
      "start_time": 12.5
    },
    {
      "role": "Therapist",
      "text": "Was an diesem Satz war so schmerzhaft?",
      "start_time": 15.5
    },
    {
      "role": "Client",
      "text": "Es hat mit einem Kommentar meines Chefs angefangen. Da bin ich explodiert.",
      "start_time": 18.6
    },
    {
      "role": "Therapist",
      "text": "Was genau hat er gesagt, und was hat das in Ihnen ausgeloest?",
      "start_time": 21.9
    },
    {
      "role": "Client",
      "text": "Als er den Kopf geschuettelt hat. Das war wie ein Schalter.",
      "start_time": 25.0
    },
    {
      "role": "Therapist",
      "text": "Dieses Kopfschuetteln scheint eine starke Bedeutung fuer Sie zu haben.",
      "start_time": 28.1
    },
    {
      "role": "Client",
      "text": "Erst war ich still, dann habe ich die Tuer zugeschlagen, dann habe ich geschrien.",
      "start_time": 31.3
    },
    {
      "role": "Therapist",
      "text": "Koennen Sie erkennen, wann der Punkt war, an dem es kippte?",
      "start_time": 34.6
    },
    {
      "role": "Client",
      "text": "Rausgehen, laufen. Aber manchmal hilft auch das nicht.",
      "start_time": 37.6
    },
    {
      "role": "Therapist",
      "text": "Lassen Sie uns gemeinsam schauen, was noch helfen koennte. Wie ist es mit bewusstem Atmen?",
      "start_time": 40.4
    },
    {
      "role": "Client",
      "text": "Ich weiss nicht, wie ich mich beruhigen soll, wenn die Wut kommt.",
      "start_time": 43.7
    },
    {
      "role": "Therapist",
      "text": "Was haben Sie bisher versucht?",
      "start_time": 46.7
    },
    {
      "role": "Client",
      "text": "Dass man mich anhoert. Dass meine Meinung zaehlt.",
      "start_time": 49.7
    },
    {
      "role": "Therapist",
      "text": "Hinter der Wut steckt also ein tiefes Beduerfnis nach Anerkennung und Gehoertwerden.",
      "start_time": 52.6
    },
    {
      "role": "Client",
      "text": "Eigentlich will ich nur, dass man mich respektiert.",
      "start_time": 55.5
    },
    {
      "role": "Therapist",
      "text": "Was bedeutet Respekt fuer Sie ganz konkret?",
      "start_time": 58.5
    }
  ],
