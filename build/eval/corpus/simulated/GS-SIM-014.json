  "messages": [
    {
      "role": "Client",
      "text": "Es geht um einen Streit mit meinem Partner. Das hat mich sehr aufgewaehlt.",
      "start_time": 0.0
    },
    {
      "role": "Therapist",
      "text": "Lassen Sie uns das gemeinsam anschauen. Was genau ist passiert?",
      "start_time": 2.8
    },
    {
      "role": "Client",
      "text": "Letzte Woche ist etwas passiert, darueber moechte ich heute sprechen.",
      "start_time": 6.0
    },
    {
      "role": "Therapist",
      "text": "Ich hoere Ihnen zu. Erzaehlen Sie mir, was vorgefallen ist.",
      "start_time": 9.2
    },
    {
      "role": "Client",
      "text": "Wuetend und unverstanden. Ich mache doch so viel fuer uns.",
      "start_time": 12.1
    },
    {
      "role": "Therapist",
      "text": "Es klingt, als fuehlen Sie sich in Ihren Bemuehungen nicht gesehen.",
      "start_time": 15.3
    },
    {
      "role": "Client",
      "text": "Er hat mir vorgeworfen, dass ich nie zuhoere. Dabei hoere ich staendig zu!",
      "start_time": 18.3
    },
    {
      "role": "Therapist",
      "text": "Wie haben Sie sich in dem Moment gefuehlt?",
      "start_time": 21.3
    },
    {
      "role": "Client",
      "text": "Ich gebe und gebe, und dann werde ich wuetend, wenn nichts zurueckkommt.",
      "start_time": 24.3
    },
    {
      "role": "Therapist",
      "text": "Da scheint ein Muster zu sein: Aufopferung, dann Enttaeuschung, dann Rueckzug.",
      "start_time": 27.2
    },
    {
      "role": "Client",
      "text": "Jetzt wo ich darueber nachdenke... das kommt immer wieder vor.",
      "start_time": 30.0
    },
    {
      "role": "Therapist",
      "text": "Was genau wiederholt sich da?",
      "start_time": 32.9
    },
    {
      "role": "Client",
      "text": "Er will wahrscheinlich einfach, dass ich praesent bin. Nicht nur koerperlich.",
      "start_time": 35.9
    },
    {
      "role": "Therapist",
      "text": "Das ist ein wichtiger Unterschied. Praesenz bedeutet mehr als Anwesenheit.",
      "start_time": 39.0
    },
    {
      "role": "Client",
      "text": "Vielleicht hat er ja auch recht, dass ich manchmal abwesend bin.",
      "start_time": 42.1
    },
    {
      "role": "Therapist",
      "text": "Was meinen Sie damit? Koennen Sie sich in seine Perspektive versetzen?",
      "start_time": 44.9
    },
    {
      "role": "Client",
      "text": "Vielleicht so: Ich brauche, dass du mich fragst, wie mein Tag war.",
      "start_time": 47.9
    },
    {
      "role": "Therapist",
      "text": "Das klingt klar und respektvoll. Wollen Sie das diese Woche ausprobieren?",
      "start_time": 50.9
    },
    {
      "role": "Client",
      "text": "Ich koennte ihm mal direkt sagen, was ich brauche, statt es zu schlucken.",
      "start_time": 53.8
    },
    {
      "role": "Therapist",
      "text": "Wie koennte das konkret aussehen?",
      "start_time": 56.7
    }
  ],
