# LeanDeep 6.0 Environment Configuration
# Copy this to .env and fill in required values

# ============================================================
# LLM PROVIDER CONFIGURATION (REQUIRED)
# ============================================================

# Google Gemini API (REQUIRED for MVP)
# Get key from: https://aistudio.google.com/app/apikeys
LEANDEEP_GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Provider Selection (default: gemini)
# Options: gemini | openrouter | ollama
LEANDEEP_LLM_PROVIDER=gemini

# LLM Call Timeout (milliseconds, default: 250)
# If Gemini exceeds this, fallback to OpenRouter
LEANDEEP_LLM_TIMEOUT=250

# ============================================================
# FALLBACK PROVIDERS (OPTIONAL)
# ============================================================

# OpenRouter API (fallback if Gemini slow/unavailable)
# Get key from: https://openrouter.ai/keys
LEANDEEP_OPENROUTER_API_KEY=

# Ollama (local LLM, privacy-first, slower)
# Requires: brew install ollama && ollama serve
LEANDEEP_OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# API SERVER CONFIGURATION
# ============================================================

# Port to run development server on
LEANDEEP_API_PORT=8420

# Host to bind to (0.0.0.0 = all interfaces)
LEANDEEP_API_HOST=0.0.0.0

# CORS Origins (comma-separated)
# For local dev: localhost:8420,localhost:3000
# For production: https://yourdomain.com
LEANDEEP_CORS_ORIGINS=localhost:8420,localhost:3000

# ============================================================
# CACHING CONFIGURATION
# ============================================================

# Cache Provider (memory = in-process; redis = distributed)
# Options: memory | redis
LEANDEEP_CACHE_PROVIDER=memory

# Redis Connection URL (only if CACHE_PROVIDER=redis)
# Format: redis://[user:password@]localhost:6379[/database]
LEANDEEP_REDIS_URL=redis://localhost:6379/0

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# SQLAlchemy database URL
# SQLite (local, no setup needed):
DATABASE_URL=sqlite:///./leandeep.db

# PostgreSQL (if using Fly.io or managed DB):
# DATABASE_URL=postgresql://user:password@localhost:5432/leandeep

# ============================================================
# LOGGING
# ============================================================

# Log Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# ============================================================
# DEVELOPMENT SETTINGS
# ============================================================

# Debug mode (true = verbose logging, slower LLM calls allowed)
DEBUG=false

# ============================================================
# TESTING CONFIGURATION
# ============================================================

# Pytest cache directory
PYTEST_CACHE_DIR=.pytest_cache

# Test database (separate from production)
TEST_DATABASE_URL=sqlite:///./test_leandeep.db

# ============================================================
# NOTES
# ============================================================

# Before deploying:
# 1. Set all REQUIRED vars (marked REQUIRED above)
# 2. For production, use secrets management:
#    - AWS Secrets Manager
#    - Fly.io Secrets
#    - Heroku Config Vars
# 3. NEVER commit .env to Git (it's in .gitignore)
# 4. NEVER log API keys (check logging config)

# For Fly.io deployment, use:
# fly secrets set LEANDEEP_GOOGLE_API_KEY=your_key
